# Configure at least one model API key. Keys stay on the server.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required for web search regardless of model provider.
TAVILY_API_KEY=
# auto chooses the first configured key: Gemini, Anthropic, then OpenAI.
# The UI can override this choice for each conversation.
MODEL_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4.1-mini
# Optional legacy alias for GEMINI_MODEL only (leave unset when using GEMINI_MODEL).
# MODEL_ID=gemini-2.5-flash
PORT=3000
DATABASE_PATH=./data/chat.sqlite
